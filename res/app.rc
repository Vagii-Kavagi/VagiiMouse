#include <winuser.h>
#include "../src/version.h"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
FILEVERSION APP_VER_MAJOR,APP_VER_MINOR,APP_VER_PATCH,0
PRODUCTVERSION APP_VER_MAJOR,APP_VER_MINOR,APP_VER_PATCH,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Vagii Mouse"
      VALUE "ProductName", "Vagii Mouse"
      VALUE "FileVersion", APP_VER_STR
      VALUE "ProductVersion", APP_VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
1 ICON "app.ico"
